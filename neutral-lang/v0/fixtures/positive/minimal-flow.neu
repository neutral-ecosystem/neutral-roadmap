neu "0.1"
module fixture_minimal_flow

use Flow

record ToolConfig {
    string image,
}

record InvocationInput {
    Ref<ToolConfig> config,
}

string image = "example.invalid/tool:1"

ToolConfig config = {
    image: image,
}

InvocationInput input = {
    config: ref(config),
}

Flow::Pipeline verify = {
    input: ref(input),
    mode: Flow::Mode.strict,
}
