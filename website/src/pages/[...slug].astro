---
import Layout from '../layouts/Layout.astro';
import { catalogTitle, loadDocs, sourceUrl } from '../lib/content';
import { projectDocuments, projects } from '../../docs.config';

export async function getStaticPaths() {
  const docs = await loadDocs();
  return docs.filter((doc) => doc.route !== '/').map((doc) => ({ params: { slug: doc.route.replace(/^\//, '').replace(/\/$/, '') }, props: { doc } }));
}
const docs = await loadDocs();
const { doc } = Astro.props;
const project = projects.find((item) => doc.sourcePath.startsWith(`${item.domain}/`));
const compactProjectLabel = project?.label.replace(/^Neutral\s+/i, '').replace(/^\w/, (letter) => letter.toUpperCase());
const selectedVersion = doc.sourcePath.match(project ? new RegExp(`^${project.domain}/(v\\d+)/`) : /^$/)?.[1];
const isProjectIndex = doc.sourcePath.endsWith('/project-index');
const portablePages = project && selectedVersion
  ? docs.filter((item) => item.sourcePath.startsWith(`${project.domain}/${selectedVersion}/portable/`))
  : [];
const portableRoot = portablePages.find((item) => item.sourcePath.endsWith('/portable/README.md'));
const versionIndex = project && selectedVersion
  ? docs.find((item) => item.sourcePath === `${project.domain}/${selectedVersion}/version-index`) ?? portableRoot
  : undefined;
const portablePrefix = project && selectedVersion ? `${project.domain}/${selectedVersion}/portable/` : '';
const projectLanding = project ? docs.find((item) => item.route === `/${project.prefix}/`) : undefined;
const topPages = project
  ? docs.filter((item) => item.sourcePath.startsWith(`${project.domain}/`) && projectDocuments.has(item.sourcePath.slice(project.domain.length + 1)))
  : [];
const versionPages = project
  ? docs.filter((item) => new RegExp(`^/${project.prefix}/v\\d+/$`).test(item.route))
  : [];
const rulePages = doc.sourcePath.startsWith('rules/') ? docs.filter((item) => item.sourcePath.startsWith('rules/')) : [];
const catalog = doc.sourcePath.startsWith('rules/')
  ? rulePages
  : project && selectedVersion && !isProjectIndex
    ? []
    : project
      ? [projectLanding, ...topPages, ...versionPages].filter((item): item is NonNullable<typeof item> => Boolean(item))
      : [];
const catalogLabel = doc.sourcePath.startsWith('rules/')
  ? 'Repository rules'
  : compactProjectLabel ?? 'Documentation';
const isVersionIndex = doc.sourcePath.endsWith('/version-index') || doc.sourcePath.endsWith('/portable/README.md');
const isGeneratedPage = isProjectIndex || doc.sourcePath.endsWith('/version-index');
const backHref = doc.sourcePath.startsWith('rules/')
  ? doc.route === '/rules/' ? '/' : '/rules/'
  : isProjectIndex
    ? '/'
    : isVersionIndex
      ? projectLanding?.route ?? '/'
      : selectedVersion
        ? versionIndex?.route ?? projectLanding?.route ?? '/'
        : projectLanding?.route ?? '/';
const backLabel = doc.sourcePath.startsWith('rules/')
  ? doc.route === '/rules/' ? 'Documentation' : 'Rules'
  : isProjectIndex
    ? 'Documentation'
    : isVersionIndex
      ? compactProjectLabel ?? 'Project'
      : selectedVersion
        ? selectedVersion
        : compactProjectLabel ?? 'Project';
const documentSourceUrl = sourceUrl(doc.sourcePath);
function normalCatalogCase(value: string) {
  return value
    .replace(/[-_]+/g, ' ')
    .toLowerCase()
    .replace(/\b[a-z]/g, (letter) => letter.toUpperCase());
}
function localCatalogTitle(item: typeof doc) {
  if (isProjectIndex && item.sourcePath.endsWith('/portable/README.md')) {
    return item.sourcePath.match(/\/(v\d+)\/portable\//)?.[1] ?? 'Version';
  }
  if (item === versionIndex && selectedVersion && !isProjectIndex) return 'Version overview';
  if (!portablePrefix || !item.sourcePath.startsWith(portablePrefix)) return catalogTitle(item, selectedVersion && !isProjectIndex ? 'version' : 'project');
  const path = item.sourcePath.slice(portablePrefix.length);
  const segments = path.replace(/\.md$/, '').split('/');
  const stem = segments.at(-1) ?? '';
  if (stem.toLowerCase() === 'readme') return segments.length === 1 ? 'Portable overview' : normalCatalogCase(segments.at(-2) ?? 'Overview');
  return normalCatalogCase(stem);
}
type CatalogTreeNode = {
  name: string;
  path: string;
  page?: typeof doc;
  children: CatalogTreeNode[];
};
function escapeHtml(value: string) {
  return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function buildPortableTree() {
  const root: CatalogTreeNode = { name: '', path: '', children: [] };
  for (const page of portablePages) {
    const relativePath = page.sourcePath.slice(portablePrefix.length);
    if (relativePath.toLowerCase() === 'readme.md') continue;
    const segments = relativePath.split('/');
    let parent = root;
    for (let index = 0; index < segments.length; index += 1) {
      const name = segments[index];
      const path = segments.slice(0, index + 1).join('/');
      let node = parent.children.find((candidate) => candidate.name === name);
      if (!node) {
        node = { name, path, children: [] };
        parent.children.push(node);
      }
      if (index === segments.length - 1) node.page = page;
      parent = node;
    }
  }
  return root;
}
function treeContainsCurrent(node: CatalogTreeNode): boolean {
  return node.page?.route === doc.route || node.children.some(treeContainsCurrent);
}
function nodeRank(node: CatalogTreeNode, parentPath: string) {
  const name = node.name.toLowerCase();
  if (!parentPath) {
    const rootOrder = ['conformance', 'development', 'specs', 'architecture.md', 'roadmap.md', 'plan.md'];
    const rank = rootOrder.indexOf(name);
    return rank === -1 ? rootOrder.length : rank;
  }
  if (name === 'readme.md') return 0;
  if (parentPath === 'specs') {
    const specsOrder = ['requirements.md', 'contracts', 'decisions', 'fixtures', 'examples'];
    const rank = specsOrder.indexOf(name);
    if (rank >= 0) return rank + 1;
  }
  const numbered = name.match(/^(\d{2})-/);
  if (numbered) return Number(numbered[1]) + 1;
  return node.children.length ? 20 : 30;
}
function sortTree(node: CatalogTreeNode) {
  node.children.sort((left, right) => nodeRank(left, node.path) - nodeRank(right, node.path) || left.name.localeCompare(right.name));
  node.children.forEach(sortTree);
}
function renderTree(nodes: CatalogTreeNode[], depth = 0): string {
  return nodes.map((node) => {
    if (node.children.length > 0) {
      const expanded = treeContainsCurrent(node) ? ' open' : '';
      return `<details class="catalog-tree-group" data-folder="${escapeHtml(node.name.toLowerCase())}"${expanded}><summary>${escapeHtml(normalCatalogCase(node.name))}</summary><div class="catalog-tree-children">${renderTree(node.children, depth + 1)}</div></details>`;
    }
    if (!node.page) return '';
    const title = node.name.toLowerCase() === 'readme.md' ? 'Overview' : localCatalogTitle(node.page);
    const active = node.page.route === doc.route ? ' list-active' : '';
    const current = node.page.route === doc.route ? ' aria-current="page"' : '';
    return `<a class="catalog-tree-link${active}" href="${escapeHtml(node.page.route)}"${current}>${escapeHtml(title)}</a>`;
  }).join('');
}
const portableTree = buildPortableTree();
sortTree(portableTree);
const catalogTreeHtml = project && selectedVersion && !isProjectIndex
  ? `${versionIndex ? `<a class="catalog-tree-link${versionIndex.route === doc.route ? ' list-active' : ''}" href="${escapeHtml(versionIndex.route)}"${versionIndex.route === doc.route ? ' aria-current="page"' : ''}>Version overview</a>` : ''}${renderTree(portableTree.children)}`
  : '';
const hasCatalog = Boolean(catalogTreeHtml || catalog.length > 0);
---
<Layout title={doc.title} description={doc.description}>
  <div class:list={['doc-shell shell', project && `project-${project.accent}`]}>
    <aside class="doc-sidebar">
      <p class="eyebrow">{catalogLabel}</p>
      {selectedVersion && !isProjectIndex && <p class="catalog-version">{selectedVersion} / portable</p>}
      {hasCatalog && <button class="catalog-toggle" type="button" aria-expanded="false" aria-controls="doc-catalog"><span>Browse docs</span><span aria-hidden="true">⌄</span></button>}
      {catalogTreeHtml
        ? <nav id="doc-catalog" class="catalog-tree" aria-label={`${catalogLabel} catalog`} set:html={catalogTreeHtml} />
        : catalog.length > 0 && <nav id="doc-catalog" aria-label={`${catalogLabel} catalog`}>{catalog.map((item) => <a class:list={{ 'list-active': item.route === doc.route }} aria-current={item.route === doc.route ? 'page' : undefined} href={item.route}>{localCatalogTitle(item)}</a>)}</nav>}
    </aside>
    <article class="document">
      <div class="document-toolbar">
        <a class="back-link" href={backHref}><span aria-hidden="true">←</span> {backLabel}</a>
        {!isGeneratedPage && documentSourceUrl && <a class="document-source" href={documentSourceUrl} target="_blank" rel="noreferrer">View source <span aria-hidden="true">↗</span></a>}
      </div>
      <p class="eyebrow">{doc.status}</p>
      <h1>{doc.title}</h1>
      <div class="markdown" set:html={doc.html} />
    </article>
  </div>
  <script>
    document.querySelectorAll<HTMLElement>('.doc-sidebar').forEach((sidebar) => {
      const toggle = sidebar.querySelector<HTMLButtonElement>('.catalog-toggle');
      toggle?.addEventListener('click', () => {
        const open = sidebar.classList.toggle('catalog-visible');
        toggle.setAttribute('aria-expanded', String(open));
      });
    });
    document.querySelectorAll<HTMLDetailsElement>('.catalog-tree-group').forEach((group) => {
      group.addEventListener('toggle', () => {
        if (!group.open) return;
        const parent = group.parentElement;
        parent?.querySelectorAll<HTMLDetailsElement>(':scope > .catalog-tree-group').forEach((sibling) => {
          if (sibling !== group) sibling.open = false;
        });
      });
    });
  </script>
</Layout>
