---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
const sections = [
  { number: '01', label: 'Language', prefix: '/language/', accent: 'blue', description: 'Language contracts, architecture, decisions, and portable specifications.' },
  { number: '02', label: 'Editor', prefix: '/editor/', accent: 'sage', description: 'Capability-driven visual authoring and editor compliance.' },
  { number: '03', label: 'Flow', prefix: '/flow/', accent: 'warm', description: 'Execution architecture, requirements, and delivery roadmap.' },
  { number: '04', label: 'Repository rules', prefix: '/rules/', accent: 'violet', description: 'Documentation structure, portability, hosting, and publication policy.' },
];
---
<Layout title="Roadmap" description="The Neutral ecosystem developer roadmap, generated from canonical Markdown.">
  <section class="home-hero shell">
    <div class="home-hero-copy">
      <p class="eyebrow">Neutral ecosystem</p>
      <h1>Roadmap</h1>
      <p class="lede">One place for the development plans, decisions, and implementation paths that shape Neutral.</p>
      <a class="home-primary-link" href="/language/">Start with the language <span aria-hidden="true">→</span></a>
    </div>
    <div class="home-hero-mark">
      <Image src="/neutral-logo.png" alt="" width={112} height={112} />
      <div class="home-color-map" aria-hidden="true">
        <span class="accent-blue"></span>
        <span class="accent-sage"></span>
        <span class="accent-warm"></span>
        <span class="accent-violet"></span>
      </div>
      <p><strong>Canonical source</strong><span>Markdown in this repository drives every page.</span></p>
    </div>
  </section>
  <section class="directory" aria-labelledby="directory-title">
    <div class="shell">
      <div class="directory-heading">
        <div>
          <p class="eyebrow">Explore the system</p>
          <h2 id="directory-title">Choose a workstream</h2>
        </div>
        <p class="directory-intro">Project-level direction stays stable. Version pages publish only their matching portable implementation material.</p>
      </div>
      <div class="directory-grid">
        {sections.map((section) => (
          <a class={`directory-card accent-${section.accent}`} href={section.prefix}>
            <span class="directory-card-top">
              <span class="directory-number">{section.number}</span>
              <span class="directory-arrow" aria-hidden="true">↗</span>
            </span>
            <span class="directory-copy">
              <strong>{section.label}</strong>
              <span>{section.description}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
