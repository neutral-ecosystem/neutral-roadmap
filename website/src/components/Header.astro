---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Language', href: '/language/' },
  { label: 'Editor', href: '/editor/' },
  { label: 'Flow', href: '/flow/' },
  { label: 'Rules', href: '/rules/' },
];
const isCurrent = (href: string) => href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href);
---
<header class="site-header">
  <div class="shell site-header-inner">
    <a class="brand" href="/" aria-label="Neutral documentation home"><img src="/neutral-logo-rounded.png" alt="" width="36" height="36" /><span>neutral docs</span></a>
    <nav aria-label="Primary navigation">
      {navItems.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <a class="source-link" href="https://github.com/neutral-ecosystem/neutral-roadmap" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
  </div>
</header>
